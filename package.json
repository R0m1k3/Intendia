{
  "name": "intendia",
  "private": true,
  "version": "0.1.23",
  "description": "Web UI to work with and administer Hermes Agent instances through their HTTP APIs only",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/server --filter ./apps/web dev",
    "dev:fake": "pnpm --filter fake-hermes dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint",
    "size": "node scripts/bundle-size.mjs --max=620",
    "release": "node scripts/release.mjs",
    "test": "pnpm -r test",
    "probe": "pnpm --filter @intendia/server probe",
    "e2e": "pnpm --filter @intendia/e2e e2e",
    "shots": "pnpm --filter @intendia/e2e shots"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9"
  }
}
