# Public address, given at install time (used for links and cookies). Needed for the links
# the agent gives through share_file (Telegram, crons).
INTENDIA_PUBLIC_URL=https://intendia.example.com

# Signs cookies and links, encrypts instance keys in the database. Generate: openssl rand -hex 32
INTENDIA_SECRET=

# Optional. Empty: the first start prints an installation code in `docker logs intendia`
# and the web UI asks you to choose a password. To set it here instead:
#   docker run --rm -i ghcr.io/r0m1k3/intendia:1 node dist/cli/hash-password.js
# (type the password, then Ctrl-D) and paste the $argon2id$... hash.
# In a .env file used by docker compose, double every $ ($$argon2id$$...).
INTENDIA_PASSWORD_HASH=

# Optional. Declare instances here instead of the web wizard (they become read-only in the UI).
# JSON array, one object per Hermes instance:
# INTENDIA_INSTANCES=[{"id":"hermes","label":"Hermes","api":"http://hermes:8642","apiKey":"...","dashboard":"http://hermes-dashboard:9119","dashboardToken":"...","mount":"/workspace"}]

# Optional. Webhook called (JSON POST with a "text" field) when a module changes state
# after a Hermes update: ntfy, n8n, a Discord/Telegram relay...
INTENDIA_WEBHOOK_URL=

# Optional. Largest file accepted by an upload, in MB (the reverse proxy must accept it too).
INTENDIA_UPLOAD_MAX_MB=200

# uid/gid Intendia runs as: the owner of the Hermes workspace volume (official image: 10000).
PUID=10000
PGID=10000
